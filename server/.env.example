PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
# Leave GROQ_API_KEY empty to run in built-in demo mode
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
CLIENT_ORIGIN=http://localhost:5173

# Optional: keep data in PostgreSQL so it never resets (Render, Neon or Supabase free plans work)
DATABASE_URL=
# Optional: also send emails for notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
